# ── Target repository (REQUIRED) ─────────────────────────────────
# The repo to document. This is the ONLY place the path is set — there is no
# --project-root CLI flag.
PROJECT_ROOT=./target-repo

# ── Output paths ─────────────────────────────────────────────────
OUTPUT_PATH=./output/openapi.yaml
METADATA_PATH=./output/api_metadata.json
REPORT_PATH=./output/readiness_report.json

# ── LLM provider (REQUIRED; default: Gemini) ─────────────────────
# An LLM is mandatory for OpenAPI generation. LLM_PROVIDER must be one of
# gemini|anthropic|openai (NOT 'none'), and the matching key below must be a
# real key — `run`/`generate` abort with exit code 2 otherwise.
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your-gemini-api-key-here   # replace with a real key
GOOGLE_MODEL=gemini-2.5-flash
# For maximum description quality on large APIs:
# GOOGLE_MODEL=gemini-2.5-pro

# Optional alternate providers (leave blank if unused)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── LLM runtime controls ─────────────────────────────────────────
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_CACHE_DIR=./.llm_cache

# ── OpenAPI document metadata ────────────────────────────────────
OPENAPI_TITLE=My Service API
OPENAPI_VERSION=1.0.0
# Server ORIGIN only. The base path (e.g. /api/v1) comes from the code's
# route paths — do not repeat it here, or it would be double-prefixed. If a
# server URL's path duplicates the common path prefix it is stripped
# automatically so the base path lives in exactly one place.
OPENAPI_SERVER_URL=http://localhost:8080
OPENAPI_SERVER_DESCRIPTION=
# Add extra environments (and OpenAPI server variables) via config.yaml.

# info.contact / info.license (optional; omitted when unset)
OPENAPI_CONTACT_NAME=
OPENAPI_CONTACT_URL=
OPENAPI_CONTACT_EMAIL=
OPENAPI_LICENSE_NAME=
OPENAPI_LICENSE_URL=

# ── Behavior flags ───────────────────────────────────────────────
STRICT_MODE=false
OUTPUT_FORMAT=yaml

# ── Generation / quality options (see config.yaml for the full set) ──
# openapi.conventional_responses: add 401/403/404/default by method+auth (opt-in)
# openapi.internal_path_prefixes: paths excluded from the public spec (/internal, /actuator)
# quality.*: production-readiness gates (unresolved, completeness, extractors)
